#!/usr/bin/env bash
# Text-rice switch. Flags in ~/.config/rice/flags/ decide which parts are live.
#   rice                     show status
#   rice on|off [part...]    parts: look bar menus tui shake (default: all)
#   rice open files|net|audio|bt|calc
#   rice autostart           called once by Hyprland
set -u
FLAGS="$HOME/.config/rice/flags"
mkdir -p "$FLAGS"
ALL=(look bar menus tui shake)
on() { [ -e "$FLAGS/$1" ]; }

bg() { setsid -f "$@" >/dev/null 2>&1 </dev/null; }

bar_start() {
    pkill -x waybar; sleep 0.2
    if on bar; then
        bg waybar -c "$HOME/.config/waybar/config.text" -s "$HOME/.config/waybar/style.text.css"
    else
        bg waybar
    fi
}
tray_apply() {
    # Kept in TUI mode too: it's the secret agent that logs VPNs in with the saved password.
    pgrep -x nm-applet >/dev/null || bg nm-applet
}
shake_apply() {
    pkill -f hypr/scripts/cursor-shake
    on shake && bg python3 -I "$HOME/.config/hypr/scripts/cursor-shake.py"
    return 0
}
apply() {
    case $1 in
        look)  hyprctl reload >/dev/null ;;
        bar)   bar_start ;;
        menus) ;; # read per call by hypr/scripts/menu
        tui)   tray_apply ;;
        shake) shake_apply ;;
    esac
}
tui() { # toggle a floating TUI
    pkill -f "foot --app-id=rice-tui-$1" && return 0
    shift_id=$1; shift
    bg foot --app-id="rice-tui-$shift_id" --window-size-chars=110x32 -- "$@"
}
open() {
    case ${1:-} in
        files) if on tui; then bg foot -- yazi; else bg nautilus; fi ;;
        net)   if on tui; then "$HOME/.config/waybar/scripts/net-menu.sh"; else bg nm-connection-editor; fi ;;
        audio) if on tui && command -v wiremix >/dev/null; then tui audio wiremix
               else pkill -x pavucontrol || bg pavucontrol; fi ;;
        bt)    if on tui; then tui bt bluetuith
               else "$HOME/.config/waybar/scripts/bluetooth-menu.sh"; fi ;;
        calc)  if ! on tui; then pkill -x gnome-calculator || bg gnome-calculator
               # Hidden, not killed: qalc only saves on quit and keeps its session while alive.
               elif hyprctl clients -j | jq -e 'any(.class == "rice-tui-calc")' >/dev/null; then
                   hyprctl dispatch 'hl.dsp.workspace.toggle_special("calc")' >/dev/null
               else bg foot --app-id=rice-tui-calc --window-size-chars=64x18 -- qalc; fi ;;
        *) echo "rice open files|net|audio|bt|calc" >&2; return 2 ;;
    esac
}

case ${1:-status} in
    status) for p in "${ALL[@]}"; do on "$p" && echo "$p on" || echo "$p off"; done ;;
    on|off)
        cmd=$1; shift
        [ $# -eq 0 ] && set -- "${ALL[@]}"
        for p in "$@"; do
            case " ${ALL[*]} " in *" $p "*) ;; *) echo "unknown part: $p" >&2; exit 2 ;; esac
            if [ "$cmd" = on ]; then touch "$FLAGS/$p"; else rm -f "$FLAGS/$p"; fi
            apply "$p"
        done ;;
    open) open "${2:-}" ;;
    autostart) bar_start; tray_apply; shake_apply ;;
    *) sed -n 2,6p "$0" >&2; exit 2 ;;
esac
