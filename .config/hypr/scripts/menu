#!/usr/bin/env bash
# Drop-in for the wofi calls in these scripts. `rice on|off menus` picks the backend.
#   menu --close   close an open menu; exit 0 only if one was open
#   menu <wofi args>
RICE_ID=rice-menu
if [ "${1:-}" = --close ]; then
    a=1; b=1
    pkill -x wofi && a=0
    pkill -f "foot --app-id=$RICE_ID" && b=0
    [ $a = 0 ] || [ $b = 0 ]; exit
fi
[ -e "$HOME/.config/rice/flags/menus" ] || exec wofi "$@"

prompt=menu width=640 lines=10 mode=dmenu exact=0 markup=0 index=0
while [ $# -gt 0 ]; do
    case $1 in
        --dmenu|-dmenu) mode=dmenu ;;
        --show) mode=$2; shift ;;
        --prompt|-p) prompt=$2; shift ;;
        --width) width=$2; shift ;;
        --lines) lines=$2; shift ;;
        --matching) [ "$2" = fuzzy ] || exact=1; shift ;;
        --allow-markup) markup=1 ;;
        -D) [ "$2" = dmenu-print_line_num=true ] && index=1; shift ;;
    esac
    shift
done

dir=$(mktemp -d "$XDG_RUNTIME_DIR/rice-menu.XXXXXX")
trap 'rm -rf "$dir"' EXIT
opts=(--reverse --no-separator --no-scrollbar --info=inline-right --color=16
      --pointer='>' --prompt="$(tr '[:upper:]' '[:lower:]' <<<"$prompt")> " --ignore-case)
[ $exact = 1 ] && opts+=(--exact)

if [ "$mode" = drun ]; then
    # "Name<TAB>desktop-id", user entries shadow system ones.
    for d in "$HOME/.local/share/applications" /usr/local/share/applications /usr/share/applications; do
        [ -d "$d" ] && find -L "$d" -name '*.desktop' 2>/dev/null
    done | while IFS= read -r f; do
        awk -v id="$(basename "$f" .desktop)" -F= '
            /^\[/ { s = ($0 == "[Desktop Entry]"); next }
            s && $1 == "Name" && !n { n = substr($0, 6) }
            s && ($1 == "NoDisplay" || $1 == "Hidden") && $2 == "true" { skip = 1 }
            END { if (n && !skip) print n "\t" id }' "$f"
    done | awk -F'\t' '!seen[$2]++' | sort -f >"$dir/in"
    opts+=(--delimiter=$'\t' --with-nth=1)
else
    cat >"$dir/in"
    if [ $markup = 1 ]; then
        sed -i -E 's/<[^>]+>//g; s/&lt;/</g; s/&gt;/>/g; s/&amp;/\&/g' "$dir/in"
    fi
    if [ $index = 1 ]; then
        awk '{ print NR-1 "\t" $0 }' "$dir/in" >"$dir/in2"; mv "$dir/in2" "$dir/in"
        opts+=(--delimiter=$'\t' --with-nth=2..)
    fi
fi

cols=$(( width / 8 )); [ $cols -lt 30 ] && cols=30
rows=$(( lines + 2 ))
foot --app-id="$RICE_ID" --title=menu --window-size-chars="${cols}x${rows}" -- \
    bash -c 'in=$1 out=$2; shift 2; fzf "$@" <"$in" >"$out"' _ "$dir/in" "$dir/out" "${opts[@]}" \
    >/dev/null 2>&1
[ -s "$dir/out" ] || exit 1

case "$mode:$index" in
    drun:*) setsid -f gtk-launch "$(cut -f2 "$dir/out")" >/dev/null 2>&1 </dev/null ;;
    *:1)    cut -f1 "$dir/out" ;;
    *)      cat "$dir/out" ;;
esac
