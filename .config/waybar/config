{
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 6,
  "modules-left": [
    "hyprland/workspaces"
  ],
  "modules-center": [],
  "modules-right": [
    "group/status",
    "clock",
    "custom/power"
  ],
  "group/status": {
    "orientation": "inherit",
    "modules": [
      "pulseaudio",
      "tray",
      "custom/aerc",
      "battery"
    ]
  },
  "pulseaudio": {
    "format": " {volume}%",
    "format-muted": " muted",
    "on-click": "pkill pavucontrol || pavucontrol"
  },
  "clock": {
    "format": "{:%Y-%m-%d %H:%M}"
  },
  "tray": {
    "icon-size": 18,
    "spacing": 8
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-alt": "{time} {icon}",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
    "tooltip-format": "{timeTo}"
  },
  "custom/power": {
    "format": "⏻",
    "tooltip": false,
    "on-click": "~/.config/waybar/scripts/power-menu.sh"
  },
  "custom/aerc": {
    "exec": "~/.config/waybar/scripts/aerc-unread.sh",
    "interval": 60,
    "return-type": "json"
  }
}
