{
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 6,
  "modules-left": [
    "ext/workspaces"
  ],
  "modules-center": [
    "custom/pomodoro",
    "custom/stand"
  ],
  "modules-right": [
    "group/status",
    "clock",
    "custom/power"
  ],
  "group/status": {
    "orientation": "inherit",
    "modules": [
      "custom/bluetooth",
      "pulseaudio",
      "tray",
      "custom/aerc",
      "battery"
    ]
  },
  // Was "hyprland/workspaces". That module clicks via Hyprland's legacy
  // `dispatch workspace N` IPC string, which a Lua hyprland config rejects
  // (Alexays/Waybar#5008, fixed in master by PR #5013, unreleased as of 0.15.0).
  // "ext/workspaces" uses the ext-workspace-v1 protocol instead, so it doesn't
  // go through Hyprland's dispatcher at all. Trade-off: no special-workspace
  // (scratchpad) indicator. Revert once waybar > 0.15.0 ships #5013.
  "ext/workspaces": {
    "on-click": "activate"
  },
  "pulseaudio": {
    "format": " {volume}%",
    "format-muted": " muted",
    "on-click": "pkill pavucontrol || pavucontrol"
  },
  "clock": {
    "format": "{:%Y-%m-%d %H:%M}"
  },
  "tray": {
    "icon-size": 18,
    "spacing": 8
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-alt": "{time} {icon}",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
    "tooltip-format": "{timeTo}"
  },
  "custom/power": {
    "format": "⏻",
    "tooltip": false,
    "on-click": "~/.config/waybar/scripts/power-menu.sh"
  },
  "custom/bluetooth": {
    "exec": "~/.config/waybar/scripts/bluetooth-status.sh",
    "interval": 10,
    "return-type": "json",
    "signal": 8,
    "on-click": "~/.config/waybar/scripts/bluetooth-menu.sh"
  },
  "custom/pomodoro": {
    "exec": "~/.config/waybar/scripts/timer.sh pomodoro 25 󰔟 manual",
    "interval": 1,
    "return-type": "json",
    "on-click": "~/.config/waybar/scripts/timer.sh pomodoro 25 󰔟 manual click",
    "on-click-right": "~/.config/waybar/scripts/timer.sh pomodoro 25 󰔟 manual reset"
  },
  "custom/stand": {
    "exec": "~/.config/waybar/scripts/timer.sh stand 50 󰖃 auto",
    "interval": 1,
    "return-type": "json",
    "on-click": "~/.config/waybar/scripts/timer.sh stand 50 󰖃 auto click",
    "on-click-right": "~/.config/waybar/scripts/timer.sh stand 50 󰖃 auto reset"
  },
  "custom/aerc": {
    "exec": "~/.config/waybar/scripts/aerc-unread.sh",
    "interval": 60,
    "return-type": "json"
  }
}
