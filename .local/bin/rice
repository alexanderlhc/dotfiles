#!/usr/bin/env bash
# Text desktop helpers.
#   rice open files|net|audio|bt|calc   open the TUI (Super+N/B/U/X call this)
#   rice autostart                      called once by Hyprland
set -u

bg() { setsid -f "$@" >/dev/null 2>&1 </dev/null; }

tui() { # toggle a floating TUI
    pkill -f "foot --app-id=rice-tui-$1" && return 0
    id=$1; shift
    bg foot --app-id="rice-tui-$id" --window-size-chars=110x32 -- "$@"
}
open() {
    case ${1:-} in
        files) bg foot -- yazi ;;
        net)   "$HOME/.config/waybar/scripts/net-menu.sh" ;;
        audio) if command -v wiremix >/dev/null; then tui audio wiremix
               else pkill -x pavucontrol || bg pavucontrol; fi ;;
        bt)    tui bt bluetuith ;;
        # Hidden, not killed: qalc only saves on quit and keeps its session while alive.
        calc)  if hyprctl clients -j | jq -e 'any(.class == "rice-tui-calc")' >/dev/null; then
                   hyprctl dispatch 'hl.dsp.workspace.toggle_special("calc")' >/dev/null
               else bg foot --app-id=rice-tui-calc --window-size-chars=64x18 -- qalc; fi ;;
        *) echo "rice open files|net|audio|bt|calc" >&2; return 2 ;;
    esac
}

case ${1:-} in
    open) open "${2:-}" ;;
    autostart)
        pkill -x waybar; sleep 0.2; bg waybar
        pkill -f hypr/scripts/cursor-shake; bg python3 -I "$HOME/.config/hypr/scripts/cursor-shake.py" ;;
    *) sed -n 2,4p "$0" >&2; exit 2 ;;
esac
