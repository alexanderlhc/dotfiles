#!/usr/bin/env bash

DMENU="wofi -dmenu --show-icons -i -p Windows"
SEP=$'\x1f'    # ASCII unit separator, unlikely to collide with titles

mapfile -t entries < <(
  hyprctl clients -j \
    | jq -r --arg SEP "$SEP" '
      .[] |
      "\(.title) (WS \(.workspace.id) on \(.monitor))" +
      "\($SEP)\(.workspace.id)" +
      "\($SEP)\(.monitor)" +
      "\($SEP)\(.address)"
    '
)

selected=$(printf '%s\n' "${entries[@]}" | $DMENU)
[ -z "$selected" ] && exit

IFS="$SEP" read -r label ws mon address <<<"$selected"

# Lua-config dispatch syntax (Hyprland >= 0.55). The old
# `hyprctl dispatch workspace ...` string is evaluated as Lua now and fails.
# The former trailing "monitor:$mon" arg was never valid for the workspace
# dispatcher and did nothing; focusing the workspace already activates its
# monitor, so it is dropped rather than translated.
hyprctl dispatch "hl.dsp.focus({workspace=\"$ws\"})"

sleep 0.05

hyprctl dispatch "hl.dsp.focus({window=\"address:$address\"})"
