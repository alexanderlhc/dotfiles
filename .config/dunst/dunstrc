# Matches the wofi menus. Colours live in dunstrc.d/, generated by tinty.
[global]
    font = monospace 11
    markup = full
    format = "<b>%a</b>: %s\n%b"
    alignment = left
    vertical_alignment = center
    word_wrap = yes
    ellipsize = end

    follow = keyboard
    origin = top-right
    offset = (4, 28)
    width = (300, 440)
    notification_limit = 5

    corner_radius = 0
    frame_width = 1
    gap_size = 2
    separator_height = 0
    padding = 6
    horizontal_padding = 10
    text_icon_padding = 14

    icon_position = off
    min_icon_size = 32
    max_icon_size = 48
    enable_recursive_icon_lookup = true
    icon_theme = "Adwaita, hicolor"

    progress_bar_height = 6
    progress_bar_frame_width = 0
    progress_bar_corner_radius = 0

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all
