{
  "layer": "top",
  "position": "top",
  "height": 22,
  "spacing": 0,
  "modules-left": [
    "ext/workspaces"
  ],
  "modules-center": [
    "hyprland/submap",
    "custom/pomodoro",
    "custom/stand"
  ],
  "modules-right": [
    "group/status",
    "clock",
    "custom/power"
  ],
  "group/status": {
    "orientation": "inherit",
    "modules": [
      "custom/vpn",
      "custom/bluetooth",
      "pulseaudio",
      "tray",
      "custom/aerc",
      "battery"
    ]
  },
  // Was "hyprland/workspaces". That module clicks via Hyprland's legacy
  // `dispatch workspace N` IPC string, which a Lua hyprland config rejects
  // (Alexays/Waybar#5008, fixed in master by PR #5013, unreleased as of 0.15.0).
  // "ext/workspaces" uses the ext-workspace-v1 protocol instead, so it doesn't
  // go through Hyprland's dispatcher at all. Trade-off: no special-workspace
  // (scratchpad) indicator. Revert once waybar > 0.15.0 ships #5013.
  "ext/workspaces": {
    "on-click": "activate"
  },
  // Modal keybinding modes (submaps): shows e.g. "screenshot" while Print
  // mode is active, hidden entirely when no submap is active.
  "hyprland/submap": {
    "format": "mode {}",
    "tooltip": false
  },
  "pulseaudio": {
    "format": "vol {volume}",
    "format-muted": "vol mute",
    "on-click": "~/.local/bin/rice open audio"
  },
  "clock": {
    "format": "{:%Y-%m-%d %H:%M}"
  },
  "tray": {
    "icon-size": 14,
    "spacing": 8
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "bat {capacity}",
    "format-charging": "chg {capacity}",
    "format-plugged": "ac {capacity}",
    "format-alt": "bat {time}",
    "tooltip-format": "{timeTo}"
  },
  "custom/vpn": {
    "exec": "~/.config/waybar/scripts/text-status.sh vpn",
    "interval": 10,
    "return-type": "json",
    "signal": 9,
    "tooltip": false,
    "on-click": "~/.local/bin/rice open net"
  },
  "custom/bluetooth": {
    "exec": "~/.config/waybar/scripts/text-status.sh bt",
    "interval": 10,
    "return-type": "json",
    "signal": 8,
    "on-click": "~/.local/bin/rice open bt"
  },
  "custom/pomodoro": {
    "exec": "~/.config/waybar/scripts/timer.sh pomodoro 25 pom manual",
    "interval": 1,
    "return-type": "json",
    "on-click": "~/.config/waybar/scripts/timer.sh pomodoro 25 pom manual click",
    "on-click-right": "~/.config/waybar/scripts/timer.sh pomodoro 25 pom manual reset"
  },
  "custom/stand": {
    "exec": "~/.config/waybar/scripts/timer.sh stand 50 stand auto",
    "interval": 1,
    "return-type": "json",
    "on-click": "~/.config/waybar/scripts/timer.sh stand 50 stand auto click",
    "on-click-right": "~/.config/waybar/scripts/timer.sh stand 50 stand auto reset"
  },
  "custom/power": {
    "format": "pwr",
    "tooltip": false,
    "on-click": "~/.config/waybar/scripts/power-menu.sh"
  },
  "custom/aerc": {
    "exec": "~/.config/waybar/scripts/text-status.sh mail",
    "interval": 60,
    "return-type": "json"
  }
}
