#!/usr/bin/env bash
# whisper-ptt — local speech-to-text dictation for Hyprland.
#
#   whisper-ptt toggle      advance the state machine (bind this to one key)
#   whisper-ptt start       begin recording
#   whisper-ptt stop        transcribe what was recorded and type it
#   whisper-ptt status      print the current state
#   whisper-ptt cancel      abort a recording, transcribing nothing
#   whisper-ptt lang [xx]   flip the language between en and da, or set one
#
# Three states, cycled by `toggle`:
#
#     idle ──press──► recording ──press──► transcribing ──┐
#      ▲                                                  │
#      └──────────────── types the text ◄─────────────────┘
#
# A press while transcribing is ignored rather than starting a second
# recording on top of the one still being processed.
#
# Transcription goes to a resident whisper-server (model already on the GPU);
# a cold whisper-cli run is the fallback if it is not up. English goes to the
# small English-only model (~0.5s for a 15s clip); every other language needs a
# multilingual model, ~3x slower, so it has its own server (whisper-server-da)
# rather than slowing English down.

set -uo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/whisper-ptt"
LANGFILE="$STATE_DIR/lang"                # the `lang` choice, kept across reboots
saved_lang=$(cat "$LANGFILE" 2>/dev/null)
LANGUAGE="${WHISPER_PTT_LANG:-${saved_lang:-en}}"   # the env var overrides `lang`

case $LANGUAGE in
    en) default_model=ggml-small.en.bin;       default_server=http://127.0.0.1:8910 ;;
    *)  default_model=ggml-large-v3-turbo.bin; default_server=http://127.0.0.1:8911 ;;
esac
MODEL="${WHISPER_PTT_MODEL:-$HOME/.local/share/whisper-models/$default_model}"
SERVER="${WHISPER_PTT_SERVER:-$default_server}"

THREADS="${WHISPER_PTT_THREADS:-8}"
SOURCE="${WHISPER_PTT_SOURCE:-}"          # empty = default input device
MAX_SECONDS="${WHISPER_PTT_MAX_SECONDS:-300}"
TRAILING_SPACE="${WHISPER_PTT_TRAILING_SPACE:-1}"
NO_TYPE="${WHISPER_PTT_NO_TYPE:-0}"       # 1 = clipboard only, no keystrokes
PUNCTUATE="${WHISPER_PTT_PUNCTUATE:-1}"   # 1 = spoken "colon" etc. become real marks
DONE_MS="${WHISPER_PTT_DONE_MS:-1200}"    # how long the finished result lingers

RUNDIR="${XDG_RUNTIME_DIR:-/tmp}/whisper-ptt"
WAV="$RUNDIR/rec.wav"
PIDFILE="$RUNDIR/rec.pid"                 # alive => recording
BUSYFILE="$RUNDIR/busy.pid"               # alive => transcribing
LOG="$RUNDIR/last.log"
EVENTS="$RUNDIR/events.log"
NOTIFY_IDFILE="$RUNDIR/notify.id"
MIN_BYTES=$((44 + 16000 * 2 * 4 / 10))    # ~0.4s of 16kHz mono s16

mkdir -p "$RUNDIR"

[[ ${WHISPER_PTT_DEBUG:-0} == 1 ]] && \
    printf '%s  %-8s pid=%s state=%s\n' \
        "$(date +%H:%M:%S.%3N)" "${1:-?}" "$$" "$(cat "$RUNDIR/.last" 2>/dev/null)" >> "$EVENTS"

# The popup is meant to be one notification that updates in place: pinned while
# recording, pinned while transcribing, gone shortly after. mako mints its own
# ids and silently ignores a replace-id it never issued, so a hardcoded one
# matches nothing and every call stacks a fresh popup -- with the pinned ones
# (-t 0) then sitting there until dismissed by hand. `-p` prints the id mako
# actually assigned; feeding that back is what makes the replace land.
note() {
    local args=(-a "Dictation" -p -t "${2:-2500}") last id
    last=$(cat "$NOTIFY_IDFILE" 2>/dev/null)
    [[ -n $last ]] && args+=(-r "$last")
    id=$(notify-send "${args[@]}" "$1" "${3:-}") && printf '%s\n' "$id" > "$NOTIFY_IDFILE"
}

# A terminal note ends the cycle, so forget the id once it is sent: the next
# press opens a fresh popup, and an id we no longer own cannot later replace
# some other application's notification.
last_note() { note "$@"; rm -f "$NOTIFY_IDFILE"; }
fail() { last_note "🚫 Dictation" 4000 "$1"; exit 1; }

lang_label() {
    case $1 in
        en) echo "🇬🇧 English" ;;
        da) echo "🇩🇰 Dansk" ;;
        *)  echo "$1" ;;
    esac
}

# A pidfile counts only while the process it names is still alive, so a crash
# can never wedge the state machine.
alive() { local p; p=$(cat "$1" 2>/dev/null) && [[ -n $p ]] && kill -0 "$p" 2>/dev/null; }

state() {
    if alive "$PIDFILE";  then echo recording;     return; fi
    if alive "$BUSYFILE"; then echo transcribing;  return; fi
    echo idle
}

transcribe() {
    local wav="$1" out
    if out=$(curl -sf -m 120 -X POST "$SERVER/inference" \
                  -F "file=@$wav" \
                  -F "language=$LANGUAGE" \
                  -F "temperature=0.0" \
                  -F "response_format=text" 2>>"$LOG"); then
        printf '%s' "$out"
        return 0
    fi
    echo "server unreachable at $SERVER, falling back to whisper-cli" >> "$LOG"
    whisper-cli -m "$MODEL" -f "$wav" -l "$LANGUAGE" -t "$THREADS" -nt -np 2>>"$LOG"
}

# wtype takes literal text, but a newline has to be sent as a Return keypress.
# Each line goes through its own `--` so text starting with "-" is safe.
type_text() {
    local first=1 line
    while IFS= read -r line; do
        [[ $first == 1 ]] || wtype -k Return
        first=0
        [[ -n $line ]] && wtype -- "$line"
    done <<< "$1"
}

do_start() {
    [[ $(state) == idle ]] || return 0
    command -v pw-record >/dev/null || fail "pw-record not found"
    [[ -f $MODEL ]] || fail "Model missing: $MODEL"

    rm -f "$WAV"
    local args=(--rate 16000 --channels 1 --format s16)
    [[ -n $SOURCE ]] && args+=(--target "$SOURCE")

    # No setsid: it forks when the child is already a process-group leader,
    # which would make $! the wrong pid and leave the recorder unstoppable.
    timeout -s INT "$MAX_SECONDS" pw-record "${args[@]}" "$WAV" \
        >/dev/null 2>"$LOG" &
    echo $! > "$PIDFILE"
    note "🎙️ Recording… $(lang_label "$LANGUAGE")" 0 "Press again to transcribe"
}

do_stop() {
    local pid
    pid=$(cat "$PIDFILE" 2>/dev/null)
    rm -f "$PIDFILE"
    if [[ -n ${pid:-} ]] && kill -0 "$pid" 2>/dev/null; then
        kill -INT "$pid" 2>/dev/null          # SIGINT lets pw-record finalise the header
        for _ in $(seq 1 60); do
            kill -0 "$pid" 2>/dev/null || break
            sleep 0.05
        done
        kill -0 "$pid" 2>/dev/null && kill -TERM "$pid" 2>/dev/null
    fi

    local bytes
    bytes=$(stat -c%s "$WAV" 2>/dev/null || echo 0)
    if (( bytes < MIN_BYTES )); then
        last_note "🎙️ Too short" 1500 "Nothing recorded"
        return 0
    fi

    # Claim the transcribing state for as long as this process lives.
    echo $$ > "$BUSYFILE"
    trap 'rm -f "$BUSYFILE"' EXIT

    note "✍️ Transcribing…" 0 ""
    local text
    text=$(transcribe "$WAV")

    # whisper emits non-speech markers like [BLANK_AUDIO]; drop them and
    # flatten segments onto one line.
    text=$(printf '%s' "$text" \
        | sed -E 's/\[[^]]*\]//g' \
        | tr '\n' ' ' \
        | sed -E 's/[[:space:]]+/ /g; s/^ +//; s/ +$//')
    # A wholly parenthesised result is a sound cue, not speech.
    [[ $text =~ ^\(.*\)$ ]] && text=""

    # Spoken punctuation ("colon" -> ":") after flattening, since it may
    # legitimately reintroduce line breaks. The commands are English phrases,
    # so other languages are left as whisper punctuated them.
    if [[ -n $text && $PUNCTUATE == 1 && $LANGUAGE == en ]] && command -v whisper-punctuate >/dev/null; then
        text=$(printf '%s' "$text" | whisper-punctuate)
    fi

    if [[ -z $text ]]; then
        last_note "🤔 No speech detected" 2000 ""
        return 0
    fi

    [[ $TRAILING_SPACE == 1 ]] && text="$text "

    printf '%s' "$text" | wl-copy
    if [[ $NO_TYPE == 1 ]]; then
        printf '%s\n' "$text"
    elif command -v wtype >/dev/null; then
        type_text "$text"
    else
        YDOTOOL_SOCKET="${YDOTOOL_SOCKET:-${XDG_RUNTIME_DIR:-/run/user/$UID}/.ydotool_socket}" \
            ydotool type --key-delay 4 -- "$text"
    fi

    last_note "✅ ${text}" "$DONE_MS" ""
}

do_cancel() {
    local pid
    pid=$(cat "$PIDFILE" 2>/dev/null)
    rm -f "$PIDFILE"
    [[ -n ${pid:-} ]] && kill -INT "$pid" 2>/dev/null
    rm -f "$WAV"
    last_note "✋ Cancelled" 1500 ""
}

# The language is read when a recording is stopped, so switching mid-recording
# applies to that take.
do_lang() {
    local new=${1:-}
    if [[ -z $new ]]; then
        [[ $LANGUAGE == en ]] && new=da || new=en
    fi
    [[ $new =~ ^[a-z]{2}$ ]] || { echo "whisper-ptt lang: expected a language code like en or da" >&2; exit 2; }

    mkdir -p "$STATE_DIR"
    printf '%s\n' "$new" > "$LANGFILE"

    if [[ $(state) == recording ]]; then
        note "🎙️ Recording… $(lang_label "$new")" 0 "Press again to transcribe"
    else
        # Not through note(): that would take over a pinned "Transcribing…" popup.
        notify-send -a "Dictation" -t 1500 "Dictation language" "$(lang_label "$new")"
    fi
}

case "${1:-toggle}" in
    toggle)
        case $(state) in
            recording)    do_stop ;;
            transcribing) note "⏳ Still transcribing…" 0 "Hang on" ;;
            idle)         do_start ;;
        esac
        ;;
    start)  do_start ;;
    stop)   do_stop ;;
    cancel) do_cancel ;;
    status) state ;;
    lang)   do_lang "${2:-}" ;;
    *) echo "usage: whisper-ptt {toggle|start|stop|cancel|status|lang [en|da]}" >&2; exit 2 ;;
esac
